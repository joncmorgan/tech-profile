---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import ProfilePictures from '@/assets/profile_pictures.jpg'
import Hero from '@/components/ui/Hero.astro'

const { 
    fullName, 
    title, 
    institute, 
    practice_statement, 
    background_pillars, 
    research_areas, 
    modes_of_engagement 
} = profile
---

<Layout>
    <!-- Hero Section -->
    <section class='flex items-center gap-12 border-b pb-12'>
        <Hero
            fullName={fullName}
            title={title}
            institute={institute}
            practiceStatement={practice_statement}
            profilePicture={ProfilePictures}
        />
    </section>

    <!-- Core Competencies -->
    <section class='py-12 border-b space-y-6'>
        <div class='mb-2'>
            <h2 class='text-2xl font-bold tracking-tight text-primary'>Core Competencies</h2>
        </div>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
            {background_pillars.map(pillar => (
                <div class='p-6 rounded-lg border bg-card flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-primary'>
                    <div>
                        <h3 class='font-semibold text-lg mb-2'>{pillar.title}</h3>
                        <p class='text-sm opacity-80 leading-relaxed'>{pillar.description}</p>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- Capability Domains (2x2 Grid) -->
    <section class='py-12 border-b space-y-6'>
        <div class='mb-2'>
            <h2 class='text-2xl font-bold tracking-tight text-primary'>Capability Domains</h2>
        </div>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
            {research_areas.map(area => (
                <div class='p-6 rounded-lg border bg-card transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-primary'>
                    <h3 class='font-semibold text-lg mb-2'>{area.title}</h3>
                    <p class='text-sm opacity-80 leading-relaxed'>{area.description}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- Modes of Engagement -->
    <section class='py-12 space-y-6'>
        <h2 class='text-2xl font-bold tracking-tight text-primary'>Modes of Engagement</h2>
        <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
            {modes_of_engagement.map(mode => (
                <div class='p-6 rounded-lg border bg-card transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-primary'>
                    <h3 class='font-semibold text-lg mb-2'>{mode.title}</h3>
                    <p class='text-sm opacity-80 leading-relaxed'>{mode.description}</p>
                </div>
            ))}
        </div>
    </section>
</Layout>