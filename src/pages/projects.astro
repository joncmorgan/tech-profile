---
import Layout from '../layouts/Layout.astro'
import projects from '@/data/transformed_projects.json'

// Extract unique taxonomy dimensions for filters
const impacts = Array.from(new Set(projects.map(p => p.impact || 'Systems Architecture')));
const domains = Array.from(new Set(projects.map(p => p.domain || 'Spatial / GIS')));
---

<Layout>
    <div class='py-8 mb-8'>
        <h1 class='text-3xl lg:text-4xl font-bold mb-2'>Projects</h1>
        <p class='text-base text-base-content/70'>
            A focused portfolio of engineering systems, computational models, and custom software architectures.
        </p>
    </div>

    {/* Dual-Axis Filter Matrix Bar */}
    <div class='max-w-3xl space-y-4 mb-10 p-4 rounded-xl border bg-card/50'>
        <!-- Axis 1: Impact Filter -->
        <div class='space-y-1.5'>
            <span class='text-xs font-semibold text-base-content/60 uppercase tracking-wider block'>Filter by Strategic Impact</span>
            <div class='flex flex-wrap gap-2' id='impact-filters'>
                <button type='button' class='btn btn-xs btn-active rounded-md normal-case font-medium impact-btn' data-impact='all'>
                    All Impacts
                </button>
                {impacts.map(impact => (
                    <button type='button' class='btn btn-xs btn-ghost rounded-md normal-case font-medium impact-btn' data-impact={impact}>
                        {impact}
                    </button>
                ))}
            </div>
        </div>

        <!-- Axis 2: Domain Filter -->
        <div class='space-y-1.5 pt-2 border-t border-base-content/10'>
            <span class='text-xs font-semibold text-base-content/60 uppercase tracking-wider block'>Filter by Core Domain</span>
            <div class='flex flex-wrap gap-2' id='domain-filters'>
                <button type='button' class='btn btn-xs btn-active rounded-md normal-case font-medium domain-btn' data-domain='all'>
                    All Domains
                </button>
                {domains.map(domain => (
                    <button type='button' class='btn btn-xs btn-ghost rounded-md normal-case font-medium domain-btn' data-domain={domain}>
                        {domain}
                    </button>
                ))}
            </div>
        </div>
    </div>

    {/* Minimal Flat List of Projects */}
    <div class='max-w-3xl space-y-3 pb-12' id='projects-container'>
        {projects.map((project, index) => (
            <button 
                type='button'
                data-project-index={index}
                data-impact={project.impact || 'Systems Architecture'}
                data-domain={project.domain || 'Spatial / GIS'}
                class='project-card text-left w-full py-3 px-4 rounded-lg border bg-card hover:border-primary transition-colors group cursor-pointer flex items-center justify-between'
            >
                <span class='font-medium text-base text-base-content group-hover:text-primary transition-colors'>{project.title}</span>
                <span class='text-base-content/40 group-hover:text-primary transition-colors'>&rarr;</span>
            </button>
        ))}
    </div>

    <!-- DaisyUI Modal Element -->
    <dialog id='project-modal' class='modal'>
        <div class='modal-box max-w-2xl space-y-6'>
            <!-- Optional Curated Domain Image -->
            <div id='modal-image-container' class='w-full h-48 rounded-lg overflow-hidden border bg-base-200 hidden'>
                <img id='modal-image' src='' alt='' class='w-full h-full object-cover' />
            </div>

            <div class='space-y-3'>
                <div class='flex flex-wrap gap-2 text-xs font-semibold text-primary uppercase tracking-wide' id='modal-badges'>
                    <span id='modal-impact-badge' class='px-2 py-1 bg-primary/10 rounded'></span>
                    <span id='modal-domain-badge' class='px-2 py-1 bg-secondary/10 rounded'></span>
                </div>
                <h3 id='modal-title' class='text-2xl font-bold text-base-content'></h3>
                <p id='modal-desc' class='text-base text-base-content/80 leading-relaxed'></p>
            </div>
            
            <!-- Main Body Content (Bullets) -->
            <div id='modal-body-container' class='hidden'>
                <h4 class='text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-2'>Execution Highlights</h4>
                <ul id='modal-bullets' class='list-disc list-inside space-y-2 text-base text-base-content/90 leading-relaxed'></ul>
            </div>

            <div class='modal-action'>
                <form method='dialog'>
                    <button class='btn btn-sm'>Close</button>
                </form>
            </div>
        </div>
        <form method='dialog' class='modal-backdrop'>
            <button>close</button>
        </form>
    </dialog>
</Layout>

<script define:vars={{ projects }}>
    // Modal Logic
    const modal = document.getElementById('project-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalBodyContainer = document.getElementById('modal-body-container');
    const modalBullets = document.getElementById('modal-bullets');
    const modalImpactBadge = document.getElementById('modal-impact-badge');
    const modalDomainBadge = document.getElementById('modal-domain-badge');
    const modalImageContainer = document.getElementById('modal-image-container');
    const modalImage = document.getElementById('modal-image');

    document.querySelectorAll('.project-card').forEach(card => {
        card.addEventListener('click', () => {
            const index = card.getAttribute('data-project-index');
            const project = projects[index];

            if (project) {
                modalTitle.textContent = project.title;
                modalDesc.textContent = project.description;
                
                // Set taxonomy badges
                modalImpactBadge.textContent = project.impact;
                modalDomainBadge.textContent = project.domain;

                // Handle image display if present
                if (project.image) {
                    modalImage.src = project.image;
                    modalImage.alt = project.title;
                    modalImageContainer.classList.remove('hidden');
                } else {
                    modalImageContainer.classList.add('hidden');
                }

                modalBullets.innerHTML = '';
                if (project.highlights && project.highlights.length > 0) {
                    modalBodyContainer.classList.remove('hidden');
                    project.highlights.forEach(highlight => {
                        const li = document.createElement('li');
                        li.textContent = highlight;
                        modalBullets.appendChild(li);
                    });
                } else {
                    modalBodyContainer.classList.add('hidden');
                }

                modal.showModal();
            }
        });
    });

    // Dual-Axis Filtering Logic for Flat List
    const impactBtns = document.querySelectorAll('.impact-btn');
    const domainBtns = document.querySelectorAll('.domain-btn');
    const projectCards = document.querySelectorAll('.project-card');

    let currentImpact = 'all';
    let currentDomain = 'all';

    function filterProjects() {
        projectCards.forEach(card => {
            const cardImpact = card.getAttribute('data-impact');
            const cardDomain = card.getAttribute('data-domain');

            const matchesImpact = (currentImpact === 'all' || cardImpact === currentImpact);
            const matchesDomain = (currentDomain === 'all' || cardDomain === currentDomain);

            if (matchesImpact && matchesDomain) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function resetDomainFilter() {
        currentDomain = 'all';
        domainBtns.forEach(b => {
            const isAll = b.getAttribute('data-domain') === 'all';
            b.classList.toggle('btn-active', isAll);
            b.classList.toggle('btn-ghost', !isAll);
        });
    }

    function resetImpactFilter() {
        currentImpact = 'all';
        impactBtns.forEach(b => {
            const isAll = b.getAttribute('data-impact') === 'all';
            b.classList.toggle('btn-active', isAll);
            b.classList.toggle('btn-ghost', !isAll);
        });
    }

    impactBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            impactBtns.forEach(b => {
                b.classList.remove('btn-active');
                b.classList.add('btn-ghost');
            });
            btn.classList.add('btn-active');
            btn.classList.remove('btn-ghost');

            currentImpact = btn.getAttribute('data-impact') || 'all';
            resetDomainFilter();
            filterProjects();
        });
    });

    domainBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            domainBtns.forEach(b => {
                b.classList.remove('btn-active');
                b.classList.add('btn-ghost');
            });
            btn.classList.add('btn-active');
            btn.classList.remove('btn-ghost');

            currentDomain = btn.getAttribute('data-domain') || 'all';
            resetImpactFilter();
            filterProjects();
        });
    });
</script>