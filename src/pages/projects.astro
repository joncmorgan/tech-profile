---
import Layout from '../layouts/Layout.astro'
import projects from '@/data/transformed_projects.json'

// Sort projects so that featured ones appear at the top
const sortedProjects = [...projects].sort((a, b) => {
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return 0;
});

// Extract unique domains for filtering tags
const domains = [...new Set(sortedProjects.map(p => p.domain).filter(Boolean))];
---

<Layout>
    <!-- Projects Title -->
    <div class='py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4'>
        <div>
            <h1 class='text-3xl lg:text-4xl font-bold'>Projects</h1>
            <p class='text-sm text-base-content/70 mt-1'>A portfolio of engineering systems, models, and software[cite: 1].</p>
        </div>
        <a 
            href='/' 
            class='inline-flex items-center justify-center px-4 py-2 text-sm font-medium rounded-md border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-colors shrink-0'
        >
            &larr; Return to Homepage
        </a>
    </div>

    <!-- Filter Bar -->
    <div class='flex flex-wrap gap-2 mb-8 pb-4 border-b border-base-200' id='filter-container'>
        <button 
            type='button' 
            data-filter='all' 
            class='filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full bg-primary text-primary-content transition-colors'
        >
            All Projects ({sortedProjects.length})
        </button>
        {domains.map(domain => (
            <button 
                type='button' 
                data-filter={domain} 
                class='filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full bg-base-200 text-base-content/80 hover:bg-base-300 transition-colors'
            >
                {domain}
            </button>
        ))}
    </div>

    <!-- Projects Grid Container -->
    <div class='grid grid-cols-1 md:grid-cols-2 gap-6 pb-12' id='projects-grid'>
        {sortedProjects.map((project, index) => (
            <div 
                data-domain={project.domain || ''}
                class='project-card flex flex-col justify-between rounded-xl border bg-card text-card-shadow p-6 hover:border-primary/50 transition-all duration-300'
            >
                <div>
                    <!-- Badges: Showing Impact -->
                    {project.impact && (
                        <div class='flex flex-wrap gap-2 text-xs font-semibold text-primary uppercase tracking-wide mb-3'>
                            <span class='px-2 py-0.5 bg-primary/10 rounded'>{project.impact}</span>
                        </div>
                    )}

                    <!-- Title -->
                    <h3 class='text-xl font-bold text-base-content'>{project.title}</h3>
                </div>

                <div>
                    <!-- Expandable Details Content: Open the first two cards by default -->
                    <details class='group border-t border-base-200 pt-3 mt-4' open={index < 2}>
                        <summary class='flex items-center justify-end text-primary cursor-pointer list-none select-none hover:text-primary/85'>
                            <span class='transition-transform group-open:rotate-180 text-base font-bold'>&darr;</span>
                        </summary>
                        
                        <div class='mt-4 space-y-4 text-sm text-base-content/90'>
                            <p class='leading-relaxed text-base-content/80'>{project.description}</p>

                            {project.highlights && project.highlights.length > 0 && (
                                <div>
                                    <h4 class='text-xs font-semibold text-base-content/60 uppercase tracking-wider mb-2'>Highlights</h4>
                                    <ul class='list-disc list-inside space-y-1.5 text-base-content/90'>
                                        {project.highlights.map(highlight => (
                                            <li>{highlight}</li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    </details>
                </div>
            </div>
        ))}
    </div>
</Layout>

<script>
    // Simple Client-Side Filtering Script
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            const filter = button.getAttribute('data-filter');

            // Update active styles on buttons
            filterButtons.forEach(btn => {
                btn.classList.remove('bg-primary', 'text-primary-content');
                btn.classList.add('bg-base-200', 'text-base-content/80');
            });
            button.classList.remove('bg-base-200', 'text-base-content/80');
            button.classList.add('bg-primary', 'text-primary-content');

            // Show/Hide cards based on filter match
            projectCards.forEach(card => {
                const cardDomain = card.getAttribute('data-domain');
                if (filter === 'all' || cardDomain === filter) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
</script>