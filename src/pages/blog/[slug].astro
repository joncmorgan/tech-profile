---
import Layout from '@/layouts/Layout.astro'
import { projects } from '@/projects'

export async function getStaticPaths() {
    return projects.map(project => ({
        params: { slug: project.slug },
        props: { project },
    }))
}

const { project } = Astro.props
---

<Layout title={`${project.title} — Projects & Systems`}>
    <article class='max-w-2xl mx-auto py-12 space-y-8'>
        <!-- Header Section -->
        <div class='space-y-3 border-b pb-6'>
            <a href='/projects' class='text-xs font-semibold text-primary hover:underline uppercase tracking-wider block'>
                &larr; Back to Projects
            </a>
            <h1 class='text-4xl font-bold tracking-tight text-base-content text-primary'>{project.title}</h1>
            <p class='text-lg text-base-content/80 leading-relaxed'>{project.description}</p>
        </div>

        <!-- Detailed Vertical Stack -->
        <div class='prose prose-neutral max-w-none text-base-content/90 leading-relaxed space-y-6'>
            <section class='space-y-4'>
                <h2 class='text-2xl font-bold text-base-content'>System Overview</h2>
                <p>Detailed architecture, operational parameters, and technical documentation for {project.title}.</p>
            </section>
        </div>
    </article>
</Layout>
