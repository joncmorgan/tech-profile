---
import { Image } from 'astro:assets'

const { fullName, title, institute, headline, subheadline, practiceStatement, profilePicture } = Astro.props
---
<div class='flex-1 space-y-6'>
  <div class='space-y-1'>
    <h1 class='text-3xl lg:text-4xl font-bold tracking-tight text-base-content'>
      {fullName}
    </h1>
    <p class='text-lg font-medium text-base-content/80'>
      {title}{institute ? ` — ${institute}` : ''}
    </p>
  </div>
  
  {headline && (
    <h2 class='text-xl font-semibold text-base-content'>
      {headline}
    </h2>
  )}

  {subheadline && (
    <p class='text-base text-base-content/70 leading-relaxed'>
      {subheadline}
    </p>
  )}

  {practiceStatement && practiceStatement.length > 0 && (
    <div class='space-y-3 text-base text-base-content/90 leading-relaxed'>
      {practiceStatement.map((paragraph: string) => (
        <p>{paragraph}</p>
      ))}
    </div>
  )}
</div>

<div class='size-72 lg:block hidden shrink-0'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full object-cover mask mask-circle size-56'
  />
</div>